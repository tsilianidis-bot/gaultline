# FAULTLINE safe environment template
# Copy values into an encrypted host-side secret manager. Never commit an .env file.
# Values below are placeholders only; no production, test, OAuth, or session secret is included.

# Runtime and build metadata
NODE_ENV=production
PORT=3000
APP_VERSION=replace-at-build-time
BUILD_COMMIT=replace-at-build-time
BUILD_TIME=replace-at-build-time
DEBUG=false

# Database: MySQL 8+ or TiDB-compatible URL. Required for application persistence.
DATABASE_URL=mysql://APP_USER:APP_PASSWORD@DB_HOST:3306/faultline

# Authentication/session security. Current project contains Manus OAuth-oriented code.
JWT_SECRET=generate-a-long-random-secret
OAUTH_SERVER_URL=https://oauth-provider.example.com
VITE_APP_ID=oauth-client-or-platform-app-id
VITE_OAUTH_PORTAL_URL=https://oauth-provider.example.com/login
GOOGLE_CLIENT_ID=optional-google-oauth-client-id-if-used
GOOGLE_CLIENT_SECRET=optional-google-oauth-client-secret-if-used
OWNER_OPEN_ID=owner-account-open-id-if-used

# Server-side AI gateway. Never expose the server key to the browser.
BUILT_IN_FORGE_API_URL=https://ai-gateway.example.com
BUILT_IN_FORGE_API_KEY=server-side-ai-gateway-key
VITE_FRONTEND_FORGE_API_URL=https://frontend-gateway.example.com
VITE_FRONTEND_FORGE_API_KEY=browser-safe-gateway-token-if-supported

# Market and macro data providers
FRED_API_KEY=fred-api-key
POLYGON_API_KEY=polygon-api-key
COINGECKO_API_KEY=coingecko-api-key

# Stripe billing: keep test and live modes separate and set matching price IDs.
STRIPE_SECRET_KEY=stripe-secret-key
VITE_STRIPE_PUBLISHABLE_KEY=stripe-publishable-key
STRIPE_WEBHOOK_SECRET=stripe-webhook-signing-secret
STRIPE_CORE_PRICE_ID=stripe-core-price-id
STRIPE_CORE_ANNUAL_PRICE_ID=stripe-core-annual-price-id
STRIPE_PREMIUM_PRICE_ID=stripe-premium-price-id
STRIPE_PREMIUM_ANNUAL_PRICE_ID=stripe-premium-annual-price-id
STRIPE_FOUNDING_PRICE_ID=stripe-founding-price-id
STRIPE_LIFETIME_PRICE_ID=stripe-lifetime-price-id
STRIPE_SKIP_VERIFICATION=false

# Email delivery
SENDGRID_API_KEY=sendgrid-api-key
SENDGRID_FROM_EMAIL=verified-sender@example.com
SENDGRID_FROM_NAME=FAULTLINE

# Analytics, error tracking, operations
VITE_GA4_MEASUREMENT_ID=G-REPLACE_ME
SENTRY_DSN=https://public@sentry.example/0
CRON_SECRET=generate-a-long-random-job-secret
HEARTBEAT_SECRET=generate-a-long-random-heartbeat-secret

# Google Search Console / Google APIs where their server integrations are enabled.
GOOGLE_CLIENT_ID=google-oauth-client-id
GOOGLE_CLIENT_SECRET=google-oauth-client-secret

# X API credentials. Required only if social-posting functions are deliberately enabled.
X_API_KEY=x-api-key
X_API_SECRET=x-api-secret
X_ACCESS_TOKEN=x-access-token
X_ACCESS_TOKEN_SECRET=x-access-token-secret

# Test/integration controls: keep false outside controlled test environments.
RUN_INTEGRATION_TESTS=false
