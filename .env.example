# FAULTLINE independent runtime — env NAMES only. Copy to the host secret manager.
# Never commit real values. Stripe is optional (null-safe if unset).

# Required for persistence (MySQL 8+ / TiDB-compatible). Do not run migrations from
# the deploy pipeline; owner runs `pnpm db:push` manually when schema must change.
DATABASE_URL=

# Session / cookie signing
JWT_SECRET=

# Staging / production-like QA: POST /api/qa/access with this secret (never in URLs).
QA_ACCESS_SECRET=

# OAuth (existing client; set redirect URIs on the provider for the staging host)
OAUTH_SERVER_URL=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# Build identity. Docker/Railway bake the git SHA into dist/build-identity.json
# (RAILWAY_GIT_COMMIT_SHA / --build-arg). Do not pin these as stale service
# variables — they override image ENV and make /api/health report an old SHA.
BUILD_COMMIT=
BUILD_TIME=

# Staging: set false so the app shell (including /qa-access) renders.
# Leave unset/on for production until the owner flips maintenance.
FAULTLINE_MAINTENANCE_MODE=false

# Listen port (Railway injects PORT). Bind is 0.0.0.0.
PORT=

# Scheduled jobs (Authorization: Bearer)
CRON_SECRET=

# Optional Stripe — server boots with stripe=null when unset. Do not point staging at live.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=

# Optional AI interpretation / ASHA (OpenAI-compatible /v1/chat/completions gateway).
# Canonical FMOS/Champion scores do not require these. OPENAI_API_KEY is not read.
# If unset, invokeLLM fails closed; FMOS AI interpretation degrades to a
# deterministic fallback and does not author Pressure.
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Optional: auto managed-preview QA on this host without a Manus hostname.
# Only when explicitly set. Do NOT set on production.
# FAULTLINE_MANAGED_PREVIEW=true
